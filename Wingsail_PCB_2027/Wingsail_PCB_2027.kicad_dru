(version 1)
(version 1)

# 1. Impedance Geometry (90 Ohm +/- 10% translated to Width & Gap)
# Replace 0.20mm (width) and 0.15mm (gap) with values for your stackup.
# The min/max bounds enforce the +/- 10% impedance tolerance window.
(rule "USB_90Ohm_Impedance_Geometry"
    (condition "A.NetName == 'D+' || A.NetName == 'D-' || A.NetName == 'In_D+' || A.NetName == 'In_D-'")
    (constraint track_width (min 0.18mm) (opt 0.20mm) (max 0.22mm))
    (constraint diff_pair_gap (min 0.13mm) (opt 0.15mm) (max 0.18mm))
)

# 2. Equal Length / Intra-Pair Skew Matching
# Keeps D+/D- and In_D+/In_D- matched within 0.15mm (~1 ps)
(rule "USB_DiffPair_Skew"
    (condition "A.NetName == 'D+' || A.NetName == 'D-' || A.NetName == 'In_D+' || A.NetName == 'In_D-'")
    (constraint skew (max 0.15mm))
)

# 3. Coplanar GND Copper Clearance (Surround with GND without detuning 90 Ohms)
# Sets at least 3x trace width (e.g., 0.60mm) between USB traces and surrounding GND pour
(rule "USB_To_GND_Pour_Clearance"
    (condition "(A.NetName == 'D+' || A.NetName == 'D-' || A.NetName == 'In_D+' || A.NetName == 'In_D-') && B.NetName == 'GND'")
    (constraint clearance (min 0.60mm))
)

# 4. Minimize / Flag Via Transitions
# Flags any via placed on the USB nets as a warning so you remember to add paired GND return vias
(rule "USB_Minimize_Vias"
    (condition "(A.NetName == 'D+' || A.NetName == 'D-' || A.NetName == 'In_D+' || A.NetName == 'In_D-') && A.Type == 'Via'")
    (constraint disallow via)
    (severity warning)
)
